# 复制为 ~/.codex/hybrid.config.toml 后，仅在本机修改占位值。
developer_instructions = """
当前会话启用了跨 Provider 子 Agent。
委派时只使用 default、worker 或 explorer，并显式设置 fork_turns="none"。
message 必须包含完成任务所需的全部上下文，不要依赖父会话历史。
子 Agent 不得继续创建其他子 Agent。
"""

[features.multi_agent_v2]
enabled = true
message_delivery = "plaintext"
tool_namespace = "agents"

[agents]
enabled = true
max_concurrent_threads_per_session = 3

[agents.default]
description = "处理边界清晰的独立任务。"
config_file = "agents/sample-general.toml"

[agents.worker]
description = "在明确范围内修改并验证文件。"
config_file = "agents/sample-editor.toml"

[agents.explorer]
description = "执行只读检查并返回证据。"
config_file = "agents/sample-reader.toml"
